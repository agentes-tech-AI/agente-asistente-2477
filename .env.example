# ══════════════════════════════════════════════════
#  Asistente 2477 — Variables de entorno
#  Estas ya están cargadas en Azure App Service.
#  Para desarrollo local copia este archivo a .env
# ══════════════════════════════════════════════════

# Azure AI Foundry
AZURE_FOUNDRY_ENDPOINT=https://aifoundryblueberry.cognitiveservices.azure.com/
AZURE_FOUNDRY_API_KEY=tu_clave_aqui
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
AZURE_FOUNDRY_API_VERSION=2024-12-01-preview

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# PostgreSQL Azure
PGHOST=asistente2477pg.postgres.database.azure.com
PGPORT=5432
PGDATABASE=asistente2477db
PGUSER=adminuser
PGPASSWORD=tu_password
PGSSLMODE=require

# Redis Upstash
REDIS_URL=rediss://default:TOKEN@sharing-gecko-125886.upstash.io:6379
REDIS_PASSWORD=tu_token_upstash
REDIS_PORT=6379

# App
NODE_ENV=production
PORT=8080
MAX_MSGS_PER_MINUTE=4
MAX_MSGS_PER_DAY=40
TYPING_DELAY_MS=800

# Panel Admin (/admin) - clave requerida para la API /api/admin
ADMIN_API_KEY=una_clave_larga_y_secreta

# Notificaciones de caso por WhatsApp (al crear el caso y en cada avance de estado)
# Fuera de la ventana de 24h desde el ultimo mensaje del cliente, WhatsApp exige una
# plantilla aprobada (Twilio Content Template). Variables de la plantilla:
#   {{1}} nombre  {{2}} numero de caso  {{3}} ticket  {{4}} estado
# Si se dejan vacios se envia texto libre (solo llega dentro de las 24h).
TWILIO_CONTENT_SID_CASO_CREADO=
TWILIO_CONTENT_SID_CASO_AVANCE=
# NOTIFICAR_AVANCES=0 desactiva los envios; NOTIFICACIONES_DRY_RUN=1 los simula (solo desarrollo)
NOTIFICAR_AVANCES=1

# Application Insights (opcional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
